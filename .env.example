# Copy to .env in repository root. Never commit actual secrets.
POSTGRES_DB=kenfit
POSTGRES_USER=kenfit
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://kenfit:change_me@localhost:5433/kenfit
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=[]
